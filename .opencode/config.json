{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/agents/AGENTS.md",
    ".opencode/agents/rules.md",
    ".opencode/agents/main-agent.md"
  ],
  "agent": {
    "build": {
      "description": "Main orchestrator for web-game-forge. Speaks OpenSpec, delegates to sub-agents, owns .opencode/ and CHANGELOG.md.",
      "mode": "primary",
      "temperature": 0.2,
      "prompt": { "file": ".opencode/agents/main-agent.md" },
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push": "ask",
          "git reset --hard": "deny",
          "git clean -fd": "deny"
        }
      }
    },
    "engine-core": {
      "description": "Owns engine/ runtime modules (PixiJS v8, Three.js r170, core systems). No new dependencies.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": { "file": ".opencode/agents/sub-agents/engine-core.md" },
      "permission": {
        "edit": {
          "*": "deny",
          "engine/**": "allow",
          ".opencode/openspec/work/**": "allow",
          "engine/config.js": "deny",
          "engine/json5-loader.js": "deny"
        }
      }
    },
    "prototype-dev": {
      "description": "Builds HTML prototypes and examples on top of the engine. Cannot modify engine/.",
      "mode": "subagent",
      "temperature": 0.3,
      "prompt": { "file": ".opencode/agents/sub-agents/prototype-dev.md" },
      "permission": {
        "edit": {
          "*": "deny",
          "examples/**": "allow",
          "templates/**": "allow",
          "prototypes/**": "allow",
          ".opencode/openspec/work/**": "allow",
          "examples/_smoke.html": "deny"
        }
      }
    },
    "config-data": {
      "description": "Owns JSON5 configs, $extend chains, default config and config loading.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": { "file": ".opencode/agents/sub-agents/config-data.md" },
      "permission": {
        "edit": {
          "*": "deny",
          "config/**": "allow",
          "engine/config.js": "allow",
          "engine/json5-loader.js": "allow",
          "prototypes/*/config.json5": "allow",
          ".opencode/openspec/work/**": "allow"
        }
      }
    },
    "qa-regression": {
      "description": "Owns smoke tests and verify.sh. Read-only over engine and prototypes; reports bugs instead of patching them.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": { "file": ".opencode/agents/sub-agents/qa-regression.md" },
      "permission": {
        "edit": {
          "*": "deny",
          "examples/_smoke.html": "allow",
          "scripts/verify.sh": "allow",
          ".opencode/openspec/work/**": "allow"
        }
      }
    },
    "tooling-release": {
      "description": "Owns dev server, export pipeline, scaffold and asset fetching scripts.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": { "file": ".opencode/agents/sub-agents/tooling-release.md" },
      "permission": {
        "edit": {
          "*": "deny",
          "scripts/**": "allow",
          "templates/**": "allow",
          "index.html": "allow",
          ".opencode/scripts/**": "allow",
          ".opencode/openspec/work/**": "allow",
          "scripts/verify.sh": "deny"
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git reset --hard": "deny",
      "git clean -fd": "deny",
      "rm -rf *": "deny",
      "curl * | sh": "deny"
    }
  },
  "mcp": {},
  "sdd": {
    "openspec": {
      "schema": ".opencode/openspec/schema.json",
      "validator": ".opencode/openspec/validate.mjs",
      "templates": ".opencode/openspec/templates",
      "workDir": ".opencode/openspec/work",
      "language": "OpenSpec 1.0 (JSON documents)"
    },
    "memory": {
      "file": ".opencode/memory.json",
      "cli": ".opencode/scripts/memory.mjs"
    },
    "vectorIndex": {
      "db": ".opencode/vector-index/index.db",
      "build": ".opencode/vector-index/reindex.sh",
      "search": ".opencode/vector-index/search.sh",
      "roots": ["engine", "config", "examples", "scripts"]
    },
    "assets": {
      "fetch": ".opencode/scripts/fetch-assets.sh",
      "runtime": "PixiJS Assets / Three.js loaders via engine/assets.js"
    }
  },
  "hooks": {
    "session.start": ["node .opencode/scripts/memory.mjs start --task \"$TASK\""],
    "session.end": ["node .opencode/scripts/memory.mjs end --auto"],
    "file.edited": ["bash .opencode/vector-index/reindex.sh --quiet"]
  }
}
